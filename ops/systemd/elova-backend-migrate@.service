[Unit]
Description=Explicit Elova backend migration for release %i
Documentation=file:/opt/elova/ops/docs/native-services-runbook.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/elova/backend/releases/%i/package.json

[Service]
Type=oneshot
User=elova-backend
Group=elova-backend
WorkingDirectory=/opt/elova/backend/releases/%i
Environment=NODE_ENV=production
Environment=NPM_CONFIG_CACHE=/var/lib/elova/backend/npm-cache
EnvironmentFile=/etc/elova/backend.env
ExecStart=/usr/bin/env npm run migrate
TimeoutStartSec=300s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
StateDirectory=elova/backend
RuntimeDirectory=elova/backend
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
