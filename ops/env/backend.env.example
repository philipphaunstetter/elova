# Install as /etc/elova/backend.env, owned by root:elova-backend with mode 0640.
# ELOVA_BACKEND_HOST must be an address assigned to tailscale0 on this GX10.
# The service unit pins port 43181; do not set PORT here.
ELOVA_BACKEND_HOST=
# Use only a same-host Unix socket or loopback PostgreSQL URL supplied out of band.
# This file is never part of an artifact.
DATABASE_URL=
# Independent base64-encoded 32-byte keys supplied out of band. Never reuse them.
ELOVA_SESSION_SECRET=
ELOVA_CREDENTIAL_KEY=
