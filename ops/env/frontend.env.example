# Install as /etc/elova/frontend.env, owned by root:elova-frontend with mode 0640.
# Use the private Tailnet HTTP origin of the GX10 backend; never use HTTPS,
# a public origin, or loopback in production. Use the explicit port in
# ops/docs/native-services-runbook.md. The service unit pins the loopback bind;
# do not set HOSTNAME or PORT here.
# Do not add NEXT_PUBLIC_ aliases.
ELOVA_BACKEND_URL=
