# Install as /etc/elova/frontend.env, owned by root:elova-frontend with mode 0640.
# Use the private Tailnet HTTP origin of the GX10 backend; never use HTTPS,
# a public origin, or loopback in production. Use explicit port 43181.
# The service unit binds only 127.0.0.1:43180; do not set HOSTNAME or PORT here.
# Do not add NEXT_PUBLIC_ aliases.
ELOVA_BACKEND_URL=
