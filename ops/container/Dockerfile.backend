# Build with a reviewed Linux ARM64 Node 22 manifest digest. No secrets or source-tree node_modules enter the context.
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/frontend/package.json apps/frontend/package.json
COPY packages/api-contract/package.json packages/api-contract/package.json
RUN npm ci --ignore-scripts
COPY apps/backend/tsconfig.json apps/backend/tsconfig.json
COPY apps/backend/src/ apps/backend/src/
RUN npm run build:backend

FROM ${NODE_IMAGE} AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/frontend/package.json apps/frontend/package.json
COPY packages/api-contract/package.json packages/api-contract/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace @elova/backend --include-workspace-root=false && npm cache clean --force

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production ELOVA_RUNTIME=container PORT=43181 ELOVA_BACKEND_HOST=0.0.0.0
WORKDIR /app/apps/backend
COPY --from=dependencies /app/node_modules /app/node_modules
COPY --from=build /app/apps/backend/dist/src ./dist/src
COPY apps/backend/migrations/*.sql ./migrations/
USER 10001:10001
EXPOSE 43181
CMD ["node", "dist/src/server.js"]
