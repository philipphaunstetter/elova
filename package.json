{
  "name": "elova-vnext",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace @elova/backend",
    "build:frontend": "npm run build --workspace @elova/frontend",
    "generate": "npm run generate --workspace @elova/api-contract",
    "lint": "eslint apps/backend/src apps/backend/test apps/frontend tests/integration",
    "package:native": "ops/bin/elova-package-native",
    "test": "npm run test:backend && npm run test:frontend && node --test tests/integration/contract.test.mjs tests/integration/container-contract.test.mjs tests/integration/frontend-container-contract.test.mjs",
    "test:backend": "npm run test --workspace @elova/backend",
    "test:frontend": "npm run test --workspace @elova/frontend"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.6",
    "js-yaml": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
