{
  "name": "@elova/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "node dist/src/migrate.js",
    "bootstrap-owner": "node dist/src/bootstrap-owner.js",
    "provision-user": "node dist/src/provision-user.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
